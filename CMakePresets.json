{
  "version": 4,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
        "CMAKE_C_STANDARD": "23",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_FLAGS_INIT": "-Wall -Wextra -Wpedantic -Werror -Wfatal-errors -Og -g3 -Wno-language-extension-token -Wno-deprecated-declarations"
      }
    }
  ]
}
